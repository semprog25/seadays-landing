# Website env example — never commit real secrets

# Optional: path to SeaDays mobile app repo (for extracting public port guides)
# SEADAYS_APP_ROOT=/absolute/path/to/Seadays-main

# Supabase (blog generation / terminal refresh)
# SUPABASE_ANON_KEY=

# Viator affiliate (same credentials as app Edge secrets). Used at static page
# generation time to bake destination deep links into Port Guide CTAs.
# Public by design in affiliate URLs; still do not commit real values.
# VIATOR_AFFILIATE_PID=
# VIATOR_AFFILIATE_MCID=
# VIATOR_AFFILIATE_MEDIUM=link
