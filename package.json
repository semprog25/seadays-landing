{
  "name": "seadays-landing",
  "version": "1.0.0",
  "private": true,
  "description": "SeaDays landing site with /api/blog proxy (no client-side Supabase key)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "generate-blogs": "node scripts/generateBlogs.js",
    "generate-blogs:ci": "node scripts/generateBlogs.js --blogs-only",
    "generate-ports:ci": "node scripts/generateBlogs.js --ports-only",
    "generate-catalogue:ci": "node scripts/generateBlogs.js --catalogue-only",
    "generate-full:ci": "node scripts/generateBlogs.js --full --allow-orphan-cleanup",
    "test:ci-channels": "node scripts/test-generate-mode.js && node scripts/test-ci-classify-generation.js && node scripts/test-catalogue-inventory.js && node scripts/test-port-seo-redirects.js && node scripts/test-image-pipeline.js && bash scripts/test-ci-safe-push.sh",
    "generate-blog-pages": "node scripts/generate-blog-pages.js",
    "generate-feature-landings": "node scripts/buildFeatureLandingPages.js",
    "generate-press": "node scripts/generate-press-assets.js",
    "apply-site-shell": "node scripts/apply-site-shell.js",
    "inject-analytics": "node scripts/inject-analytics-head.js",
    "inject-blog-ad-slots": "node scripts/inject-blog-ad-slots.js",
    "extract-public-port-guides": "node scripts/extract-public-port-guides.js",
    "extract-public-port-terminals": "node scripts/extract-public-port-terminals.js",
    "regenerate-port-pages": "node scripts/regenerate-port-pages.js",
    "inject-blog-port-links": "node scripts/inject-blog-port-links.js",
    "smoke-port-guides": "node scripts/smoke-port-guides.js",
    "test-image-pipeline": "node scripts/test-image-pipeline.js",
    "test-seo-phase1": "node scripts/test-seo-phase1.js",
    "test-port-seo-redirects": "node scripts/test-port-seo-redirects.js",
    "upload-press-screenshots": "node scripts/upload-press-screenshots.js",
    "upload-press-marketing": "node scripts/upload-press-marketing.js",
    "regenerate-ports-index": "node scripts/regenerate-ports-index.js",
    "fix-featured-guide-thumbnails": "node scripts/fix-featured-guide-thumbnails.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.2.0",
    "@supabase/supabase-js": "^2.45.0"
  }
}
